# Fern Client Backend Configuration
PORT=4000
NODE_ENV=development

# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/fern_client?schema=public"

# Authentication & JWT Secrets (MUST be changed in production)
JWT_SECRET="fern_client_jwt_super_secret_signing_key_at_least_32_chars_long"
JWT_EXPIRATION="7d"
REFRESH_TOKEN_EXPIRATION="30d"

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,tauri://localhost,http://localhost:4000"

# Rate Limiting
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Email Delivery (Optional for development testing)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@fernclient.com"
DEV_EMAIL_BYPASS=true

# Storage & Quotas
MAX_SYNC_PAYLOAD_BYTES=5242880 # 5 MB max synchronized config
PRESENCE_STALE_TIMEOUT_MS=60000 # 60 seconds
